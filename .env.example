# Copiez ce fichier en ".env" (à la racine du projet, à côté de docker-compose.yml)
# et renseignez l'URL ngrok réelle de votre serveur Flask de télémétrie.
# Ce fichier .env ne doit JAMAIS être commité (voir .gitignore).

# URL de base du serveur Flask distant (sans le chemin /api/telemetry/latest)
GREENHOUSE_TELEMETRY_URL=https://votre-tunnel.ngrok-free.dev

# Intervalle de polling HTTP en secondes (def. 20)
TELEMETRY_POLL_SECONDS=20
